      "name": "A. CRUD",
      "item": [
        {
          "name": "Semua Streaming",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code adalah 200', function () {\r\n  pm.response.to.have.status(200);\r\n});\r\n\r\npm.test('Response berupa array', function () {\r\n  const jsonData = pm.response.json();\r\n  pm.expect(jsonData).to.be.an('array');\r\n});\r\n\r\npm.test('Setiap data memiliki id dan judul', function () {\r\n  const jsonData = pm.response.json();\r\n  jsonData.forEach((item) => {\r\n    pm.expect(item).to.have.property('id');\r\n    pm.expect(item).to.have.property('judul');\r\n  });\r\n});\r\n\r\npm.test('Response time di bawah 500ms', function () {\r\n  pm.expect(pm.response.responseTime).to.be.below(500);\r\n});\r\n\r\npm.test('Data streaming pertama berjudul Rahasia Kampus Tua', function () {\r\n  const jsonData = pm.response.json();\r\n  pm.expect(jsonData[0].judul).to.eql('Rahasia Kampus Tua');\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/tv-series",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tv-series"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Tambah Streaming",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code adalah 201', function () {\r\n  pm.response.to.have.status(201);\r\n});\r\n\r\npm.test('Data baru memiliki id dan judul sesuai kiriman', function () {\r\n  const jsonData = pm.response.json();\r\n  pm.expect(jsonData).to.have.property('id');\r\n  pm.expect(jsonData.judul).to.eql('Tunggu Aku Sukses Nanti');\r\n});\r\n\r\nif (pm.response.code === 201) {\r\n  pm.environment.set('streamingId', pm.response.json().id);\r\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{api-key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
