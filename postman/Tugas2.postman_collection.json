              "mode": "raw",
              "raw": "{\r\n    \"judul\": \"Tunggu Aku Sukses Nanti\",\r\n    \"jumlahEpisode\": 1,\r\n    \"status\": \"Tamat\",\r\n    \"studio\": \"Falcon Pictures\",\r\n    \"tahunRilis\": 2026\r\n}",
